<resources>

    <!-- Light theme. values-night redefines Base.AppTheme with a dark parent
         and the palette flips through values-night/colors.xml. -->
    <style name="Base.AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="actionBarStyle">@style/AppTheme.ActionBar</item>
        <item name="materialButtonStyle">@style/Widget.BirrBridge.Button.Text</item>
    </style>

    <style name="AppTheme" parent="Base.AppTheme" />

    <!-- App bar: flat surface color, title comes from theme. -->
    <style name="AppTheme.ActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@color/colorSurface</item>
        <item name="elevation">4dp</item>
    </style>

    <!-- Section headers used in forms (uppercase, accent color). -->
    <style name="AppTheme.SectionHeader" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Helper / caption text. -->
    <style name="AppTheme.HelperText" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>

    <!-- Switch rows in forms. -->
    <style name="AppTheme.SwitchRow" parent="">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <!-- Outlined text input fields. -->
    <style name="AppTheme.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="helperTextEnabled">true</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
    </style>

    <!-- Material cards used for list items and form sections. -->
    <style name="Widget.BirrBridge.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
    </style>

    <!-- Text buttons in list rows. -->
    <style name="Widget.BirrBridge.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">72dp</item>
    </style>

</resources>
